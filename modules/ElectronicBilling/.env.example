# Configuración de Entorno para Módulo de Facturación Electrónica SRI

# Entorno SRI: 1 = Pruebas, 2 = Producción
SRI_ENVIRONMENT=1

# URL WebServices SRI Pruebas
SRI_WS_RECEPCION_TEST=https://celcer.sri.gob.ec/comprobantes-electronicos-ws/RecepcionComprobantesOffline?wsdl
SRI_WS_AUTORIZACION_TEST=https://celcer.sri.gob.ec/comprobantes-electronicos-ws/AutorizacionComprobantesOffline?wsdl

# URL WebServices SRI Producción
SRI_WS_RECEPCION_PROD=https://cel.sri.gob.ec/comprobantes-electronicos-ws/RecepcionComprobantesOffline?wsdl
SRI_WS_AUTORIZACION_PROD=https://cel.sri.gob.ec/comprobantes-electronicos-ws/AutorizacionComprobantesOffline?wsdl

# Base de Datos (EF Core)
DB_CONNECTION_STRING=Host=localhost;Database=ElectronicBillingDb;Username=postgres;Password=secret

# Clave Maestra de Cifrado para Certificados .p12
MASTER_ENCRYPTION_KEY=ElectronicBilling_MasterSecret_Key_Change_In_Production_32Bytes!
